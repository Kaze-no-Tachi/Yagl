# --- Core ---
ENVIRONMENT=development
# In Docker this points at the "db" service. For local dev outside Docker use localhost.
DATABASE_URL=postgresql+psycopg2://yagl:yagl@db:5432/yagl
# CHANGE THIS. Signs JWTs and encrypts stored store credentials.
SECRET_KEY=please-change-me-to-a-long-random-string
# Comma-separated, or * for all (dev only).
CORS_ORIGINS=*

# --- Photo storage ---
STORAGE_BACKEND=local
MEDIA_ROOT=/data/media
MEDIA_URL_BASE=/media

# --- IGDB (Twitch) — get from https://dev.twitch.tv/console/apps ---
# Without these, scan/search return no metadata but manual add still works.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Barcode resolution ---
# https://www.gameupc.com/  (primary, game-specific UPC -> game)
GAMEUPC_API_KEY=
# https://www.upcitemdb.com/  (optional fallback; trial works without a key)
UPCITEMDB_API_KEY=

# --- Digital library import ---
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
